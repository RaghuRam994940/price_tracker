# ==========================================
# OMNIDROP / VECHI: ENVIRONMENT TEMPLATE
# (Replace with your actual keys in .env)
# ==========================================

# 1. SUPABASE CLIENT & PUBLIC CONFIG (Browser & Server)
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 2. SUPABASE SERVICE ROLE SECRET (Worker & Background Jobs ONLY - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret
SUPABASE_URL=https://your-project.supabase.co

# 3. RESEND TRANSACTIONAL EMAIL API
# Get your free API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=OmniDrop Alerts <onboarding@resend.dev>

# 4. SEARCH API (Optional Google Custom Search JSON API)
GOOGLE_SEARCH_API_KEY=your_google_custom_search_api_key
GOOGLE_SEARCH_CX=your_search_engine_cx_id

# 5. APPLICATION URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
